<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id='hr_hospital_doctor_category_list' model='ir.ui.view'>
        <field name='name'>hr_hospital.doctor.category.list</field>
        <field name='model'>hr_hospital.doctor.category</field>
        <field name='arch' type='xml'>
            <list string='Categories'>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="qualification_category"></field>
                <field name="doctor_amount"/>
            </list>
        </field>
    </record>

    <record id='hr_hospital_doctor_category_form' model='ir.ui.view'>
        <field name='name'>hr_hospital.doctor.category.form</field>
        <field name='model'>hr_hospital.doctor.category</field>
        <field name='arch' type='xml'>
            <form string="Category">
                <sheet>
                    <group>
                        <field name="name" placeholder="Doctor category"/>
                        <field name="qualification_category"/>
                    </group>
                    <notebook>
                        <page string="Doctors">
                            <field name="doctor_ids" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id='hr_hospital_doctor_category_action_window' model='ir.actions.act_window'>
        <field name='name'>Categories</field>
        <field name="res_model">hr_hospital.doctor.category</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>