<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_hospital_disease_report_wizard_form" model="ir.ui.view">
        <field name="name">hr_hospital.disease.report.wizard.form</field>
        <field name="model">hr_hospital.disease.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Disease Report">
                <group>
                    <group>
                        <group>
                            <field name="start_date"/>
                        </group>
                        <group>
                            <field name="end_date"/>
                        </group>
                    </group>
                    <separator/>
                    <group>
                        <field name="doctor_ids" widget="many2many_tags"/>
                    </group>
                    <group>
                        <field name="disease_ids" widget="many2many_tags"/>
                    </group>
                </group>
                <footer>
                    <button name="action_generate_report"
                            string="Generate Report"
                            type="object"
                            class="btn-primary"/>

                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="disease_report_wizard_action" model="ir.actions.act_window">
        <field name="name">Disease Report</field>
        <field name="res_model">hr_hospital.disease.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_hr_hospital_doctor_disease_report"  model="ir.actions.server">
        <field name="name">Disease Report</field>
        <field name="model_id" ref="model_hr_hospital_doctor"/>
        <field name="binding_model_id"  ref="model_hr_hospital_doctor"/>
        <field name="binding_view_types">list,form</field>
        <field name="binding_type">report</field>
        <field name="state">code</field>
        <field name="code">
            action = {
                'type': 'ir.actions.act_window',
                'name': 'Disease Report',
                'res_model': 'hr_hospital.disease.report.wizard',
                'view_mode': 'form',
                'target': 'new',
                'context': {
                'default_doctor_ids': [(6, 0, records.ids)],
            }
        }
        </field>
    </record>

</odoo>