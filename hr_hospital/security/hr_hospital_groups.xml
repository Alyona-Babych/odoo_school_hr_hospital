<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="category_hr_hospital" model="ir.module.category">
        <field name="name">Hospital</field>
        <field name="sequence">10</field>
    </record>

    <record id="privilege_hr_hospital" model="res.groups.privilege">
        <field name="name">Hospital</field>
        <field name="sequence">1</field>
        <field name="category_id" ref="hr_hospital.category_hr_hospital"/>
        <field name="sequence">1</field>
    </record>

    <record id="group_patient" model="res.groups">
        <field name="name">Patient</field>
        <field name="privilege_id" ref="hr_hospital.privilege_hr_hospital"/>
        <field name="comment">Patients of the HR Hospital</field>
        <field name="sequence">1</field>
    </record>

    <record id="group_intern" model="res.groups">
        <field name="name">Intern</field>
        <field name="privilege_id" ref="hr_hospital.privilege_hr_hospital"/>
        <field name="implied_ids" eval="[Command.link(ref('hr_hospital.group_patient'))]"/>
        <field name="comment">Interns of the HR Hospital</field>
        <field name="sequence">2</field>
    </record>

    <record id="group_doctor" model="res.groups">
        <field name="name">Doctor</field>
        <field name="privilege_id" ref="hr_hospital.privilege_hr_hospital"/>
        <field name="implied_ids" eval="[Command.link(ref('hr_hospital.group_intern'))]"/>
        <field name="comment">Doctors of the HR Hospital</field>
        <field name="sequence">3</field>
    </record>

    <record id="group_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="hr_hospital.privilege_hr_hospital"/>
        <field name="implied_ids" eval="[Command.link(ref('hr_hospital.group_doctor'))]"/>
        <field name="comment">Managers of the HR Hospital</field>
        <field name="sequence">4</field>
    </record>

    <record id="group_administrator" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="hr_hospital.privilege_hr_hospital"/>
        <field name="implied_ids" eval="[Command.link(ref('hr_hospital.group_manager'))]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_admin'))]"/>
        <field name="comment">Administrator of the HR Hospital</field>
        <field name="sequence">5</field>
    </record>

</odoo>