<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id='hr_hospital_doctor_list' model='ir.ui.view'>
        <field name='name'>hr_hospital.doctor.list</field>
        <field name='model'>hr_hospital.doctor</field>
        <field name='arch' type='xml'>
            <list string='Doctors'>
                <field name="color" invisible="1"/>
                <field name="name"
                        decoration-success="color in (6, 7)"
                        decoration-warning="color in (3, 4, 5)"
                        decoration-danger="color in (1, 2)"
                        decoration-info="color in (8, 9)"
                        decoration-primary="color in (10, 11)"/>
                <field name="specialization"/>
                <field name="phone"/>
                <field name="is_intern"
                       widget="boolean_toggle"
                       decoration-success="is_intern"
                       invisible="not is_intern"/>
                <field name="mentor_name"
                       invisible="not is_intern"/>
            </list>
        </field>
    </record>

    <record id='hr_hospital_doctor_form' model='ir.ui.view'>
        <field name='name'>hr_hospital.doctor.form</field>
        <field name='model'>hr_hospital.doctor</field>
        <field name='arch' type='xml'>
            <form string="Doctor">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Doctor full name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="gender"/>
                            <field name="birth_date"/>
                            <field name="age"/>
                            <field name="phone"/>
                            <field name="email"/>
                        </group>
                        <group>
                            <group>
                                <field name="category_id"/>
                                <field name="specialization"/>
                            </group>
                            <newline/>
                            <group string="Mentor info" invisible="not is_intern">
                                <field name="mentor_id"
                                       domain="[('id', '!=', id), ('is_intern', '=', False)]"/>
                                <field name="mentor_specialization"/>
                                <field name="mentor_category"/>
                            </group>
                        </group>
                    </group>

                    <notebook>
                        <page string="Interns Info" invisible="is_intern">
                            <field name="intern_ids" readonly="1">
                                <kanban edit="0" delete="0" create="0">
                                    <templates>
                                         <t t-name="card">
                                            <div class="oe_kanban_card"
                                                 style="background: #fff;
                                                        border-left: 4px solid #00a09d;
                                                        border-radius: 10px;
                                                        padding: 12px;">
                                                <h4 class="mb-1">
                                                    <field name="name"/>
                                                </h4>
                                                <div class="text-muted">
                                                    <field name="gender"/> • <field name="age"/>
                                                </div>
                                                <div>
                                                    <field name="specialization"/>
                                                </div>
                                            </div>
                                         </t>
                                    </templates>
                                </kanban>
                            </field>
                        </page>
                        <page string="Personal Patients" invisible="is_intern">
                            <field name="personal_patient_ids" readonly="1">
                                <list create="0" delete="0">
                                    <field name="name"/>
                                </list>
                                <form string="Patient" create="0" edit="0" delete="0">
                                    <sheet>
                                        <group>
                                            <field name="name"/>
                                            <field name="gender"/>
                                            <field name="age"/>
                                        </group>
                                        <group col="2">
                                            <group>
                                                <field name="blood_group"/>
                                                <field name="policy_number"/>
                                            </group>
                                            <group>
                                                <field name="rh_factor"/>
                                            </group>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_hospital_doctor_kanban" model="ir.ui.view">
        <field name="name">hr_hospital.doctor.kanban</field>
        <field name="model">hr_hospital.doctor</field>
         <field name="arch" type="xml">
             <kanban string="Doctors" default_group_by="category_id" highlight_color="color">
                 <field name="color"/>
                 <field name="name"/>
                 <field name="category_id"/>
                 <field name="intern_names"/>
                 <field name="color"/>
                 <templates>
                     <t t-name="card">
                         <div class="oe_kanban_card"
                              style="background: #fff;
                                     border-left: 4px solid #00a09d;
                                     border-radius: 10px;
                                     padding: 12px;">
                              <h4><field name="name"/></h4>
                             <div class="text-muted mt-1">
                                <field name="specialization"/>
                             </div>
                             <div t-if="record.intern_names.raw_value" class="mt-2">
                                <strong>Interns: </strong>
                                <span class="text-muted">
                                    <t t-out="record.intern_names.value"/>
                                </span>
                            </div>
                             <div style="margin-top: 12px; display: flex; justify-content: flex-end;">
                                <button type="object"
                                        name="action_create_appointment"
                                        string="Create Appointment"
                                        class="btn-info"/>
                             </div>
                         </div>
                     </t>
                     <t t-name="menu">
                        <a role="menuitem" type="open"
                           class="dropdown-item">Open</a>
                        <a role="menuitem" type="archive"
                           class="dropdown-item">Archive</a>
                        <a role="menuitem" type="delete"
                           class="dropdown-item">Delete</a>
                        <field name="color" widget="kanban_color_picker"/>
                     </t>
                 </templates>
             </kanban>
         </field>
    </record>

    <record id="hr_hospital_doctor_search" model="ir.ui.view">
        <field name="name">hr_hospital.doctor.search</field>
        <field name="model">hr_hospital.doctor</field>
         <field name="arch" type="xml">
             <search>
                 <field name="name" filter_domain="[('name', 'ilike', self)]"/>

                 <filter name="filter_is_intern" string="Intern" domain="[('is_intern', '=', True)]"/>
                 <filter name="filter_is_mentor" string="Mentor" domain="[('intern_ids', '!=', False)]"/>
             </search>
         </field>
    </record>

    <record id='hr_hospital_doctor_action_window' model='ir.actions.act_window'>
        <field name='name'>Doctors</field>
        <field name="res_model">hr_hospital.doctor</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="hr_hospital_doctor_search"/>
    </record>

</odoo>