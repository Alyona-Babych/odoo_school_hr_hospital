<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id='hr_hospital_patient_list' model='ir.ui.view'>
        <field name='name'>hr_hospital.patient.list</field>
        <field name='model'>hr_hospital.patient</field>
        <field name='arch' type='xml'>
            <list string='Patients'>
                <field name="name"/>
                <field name="gender"/>
                <field name="phone"/>
                <field name="personal_doctor_id"/>
            </list>
        </field>
    </record>

    <record id='hr_hospital_patient_form' model='ir.ui.view'>
        <field name='name'>hr_hospital.patient.form</field>
        <field name='model'>hr_hospital.patient</field>
        <field name='arch' type='xml'>
            <form string="Patient">
                <header>
                    <button name="action_open_appointment_list"
                            type="object"
                            string="Open Appointments"
                            class="btn-primary"/>
                    <button name="action_create_appointment"
                            type="object"
                            string="Create Appointments"
                            class="btn-success"/>
                    </header>

                <sheet>

                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Patient Full Name"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="gender"/>
                            <field name="birth_date"/>
                            <field name="age"/>
                        </group>
                        <group>
                            <field name="phone"/>
                            <field name="email"/>
                        </group>
                    </group>

                    <group string="Medical Info">
                        <group>
                            <field name="personal_doctor_name"/>
                        </group>
                        <group col="2">
                            <group>
                                <field name="blood_group"/>
                                <field name="policy_number"/>
                            </group>
                            <group>
                                <field name="rh_factor"/>
                            </group>
                        </group>
                    </group>

                    <notebook>
                        <page string="Personal Doctor History">
                            <field name="doctor_history_ids" readonly="1">
                                <list create="0" delete="0">
                                    <field name="display_name"/>
                                </list>
                            </field>
                        </page>

                        <page string="Treating Doctors">
                            <field name="doctor_ids" readonly="1">
                                <list create="0" delete="0">
                                    <field name="name"/>
                                </list>
                                <form string="Doctor" create="0" edit="0" delete="0">
                                    <sheet>
                                        <group>
                                            <field name="name"/>
                                            <field name="category_id"/>
                                            <field name="specialization"/>
                                            <field name="mentor_id"
                                               domain="[('id', '!=', id), ('is_intern', '=', False)]"
                                               invisible="not is_intern"/>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_hospital_patient_search" model="ir.ui.view">
        <field name="name">hr_hospital.patient.search</field>
        <field name="model">hr_hospital.patient</field>
         <field name="arch" type="xml">
             <search>
                 <field name="name"  filter_domain="[('name','ilike',self)]"/>
                 <field name="phone" filter_domain="[('phone','ilike',self)]"/>
             </search>
         </field>
    </record>


    <record id='hr_hospital_patient_action_window' model='ir.actions.act_window'>
        <field name='name'>Patients</field>
        <field name="res_model">hr_hospital.patient</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="hr_hospital_patient_search"/>
    </record>

</odoo>