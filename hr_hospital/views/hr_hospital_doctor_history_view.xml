<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id='hr_hospital_doctor_history_list' model='ir.ui.view'>
        <field name='name'>hr_hospital.doctor.history.list</field>
        <field name='model'>hr_hospital.doctor.history</field>
        <field name='arch' type='xml'>
            <list string='Doctor History'>
                <field name="display_name"/>
            </list>
        </field>
    </record>

    <record id='hr_hospital_doctor_history_form' model='ir.ui.view'>
        <field name='name'>hr_hospital.doctor.history.form</field>
        <field name='model'>hr_hospital.doctor.history</field>
        <field name='arch' type='xml'>
            <form string="Doctor History">
                <sheet>
                    <group>
                        <group>
                            <field name="patient_id"/>
                            <field name="doctor_id"
                                   domain="[('is_intern', '=', False)]"/>
                        </group>
                        <group>
                            <field name="doctor_assignment_date"/>
                            <field name="doctor_change_date"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id='hr_hospital_doctor_history_action_window' model='ir.actions.act_window'>
        <field name='name'>Doctor History</field>
        <field name="res_model">hr_hospital.doctor.history</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'group_by': 'patient_id'}</field>
    </record>

</odoo>