<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_hospital_mass_reassign_doctor_wizard_form" model="ir.ui.view">
        <field name="name">hr_hospital.mass.reassign.doctor.wizard.form</field>
        <field name="model">hr_hospital.mass.reassign.doctor.wizard</field>
        <field name="arch" type="xml">
            <form string="Reassign Doctor to Patients">
                <group col="2">
                    <group>
                        <field name="doctor_id"/>
                    </group>
                    <group>
                        <field name="reassignment_date"/>
                    </group>
                </group>
                <footer>
                    <button name="action_reassign_doctor"
                            string="Apply"
                            type="object"
                            class="btn-primary"/>

                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id='hr_hospital_mass_reassign_doctor_wizard_action_window' model='ir.actions.act_window'>
        <field name='name'>Reassign doctor</field>
        <field name="res_model">hr_hospital.mass.reassign.doctor.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_hr_hospital_patient"/>
        <field name="binding_view_types">list</field>
    </record>

</odoo>