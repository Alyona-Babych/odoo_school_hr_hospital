<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id='hr_hospital_disease_list' model='ir.ui.view'>
        <field name='name'>hr_hospital.disease.list</field>
        <field name='model'>hr_hospital.disease</field>
        <field name='arch' type='xml'>
            <list string='Diseases'>
                <field name="display_name"/>
            </list>
        </field>
    </record>

    <record id='hr_hospital_disease_form' model='ir.ui.view'>
        <field name='name'>hr_hospital.disease.form</field>
        <field name='model'>hr_hospital.disease</field>
        <field name='arch' type='xml'>
            <form string="Disease">
                <sheet>
                    <group>
                        <group>
                            <field name="icd_code"/>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="category_id"/>
                        </group>
                    </group>
            </sheet>
            </form>
        </field>
    </record>

    <record id="hr_hospital_disease_search" model="ir.ui.view">
        <field name="name">hr_hospital.disease.search</field>
        <field name="model">hr_hospital.disease</field>
         <field name="arch" type="xml">
             <search>
                 <searchpanel>
                     <field name="category_id" string="Diseases" icon="fa-medkit" select="one" hierarchize="1"/>
                 </searchpanel>
             </search>
         </field>
    </record>

    <record id='hr_hospital_disease_action_window' model='ir.actions.act_window'>
        <field name='name'>Diseases</field>
        <field name="res_model">hr_hospital.disease</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="hr_hospital_disease_search"/>
    </record>

</odoo>