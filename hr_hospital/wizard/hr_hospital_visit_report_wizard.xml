<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_hospital_visit_report_wizard_form" model="ir.ui.view">
        <field name="name">hr_hospital.visit.report.wizard.form</field>
        <field name="model">hr_hospital.visit.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Patient Visit Report">
                <group>
                    <group>
                        <field name="doctor_ids" widget="many2many_tags"/>
                        <field name="patient_ids" widget="many2many_tags"/>
                    </group>
                    <group>
                        <field name="disease_ids" widget="many2many_tags"/>
                        <field name="start_date"/>
                        <field name="end_date"/>
                        <field name="is_done_appointment" widget="boolean_toggle"/>
                    </group>
                </group>
                <footer>
                    <button name="action_generate_report"
                            string="Generate Report"
                            type="object"
                            class="btn-primary"/>

                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="visit_report_patient_action" model="ir.actions.act_window">
        <field name="name">Visit Report</field>
        <field name="res_model">hr_hospital.visit.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_hr_hospital_patient"/>
        <field name="binding_view_types">list,form</field>
    </record>

    <record id="visit_report_doctor_action" model="ir.actions.act_window">
        <field name="name">Visit Report</field>
        <field name="res_model">hr_hospital.visit.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_hr_hospital_doctor"/>
        <field name="binding_view_types">list,form</field>
    </record>

</odoo>