<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id='hr_hospital_doctor_list' model='ir.ui.view'>
        <field name='name'>hr_hospital.doctor.list</field>
        <field name='model'>hr_hospital.doctor</field>
        <field name='arch' type='xml'>
            <list string='Doctors'>
                <field name="name"/>
                <field name="specialization"/>
                <field name="phone"/>
                <field name="is_intern"
                       widget="boolean_toggle"
                       decoration-success="is_intern"
                       invisible="not is_intern"/>
                <field name="mentor_name"
                       invisible="not is_intern"/>
            </list>
        </field>
    </record>

    <record id='hr_hospital_doctor_form' model='ir.ui.view'>
        <field name='name'>hr_hospital.doctor.form</field>
        <field name='model'>hr_hospital.doctor</field>
        <field name='arch' type='xml'>
            <form string="Doctor">
                <sheet>

                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Doctor full name"/>
                        </h1>
                        <div class="o_row">
                            <group col="2">
                                <group>
                                    <field name="gender"/>
                                    <field name="birth_date"/>
                                    <field name="age"/>
                                    <field name="phone"/>
                                    <field name="email"/>
                                </group>
                                <group>
                                    <field name="category_id"/>
                                    <field name="specialization"/>
                                    <field name="mentor_id"
                                           domain="[('id', '!=', id), ('is_intern', '=', False)]"
                                           invisible="not is_intern"/>
                                </group>
                            </group>
                        </div>
                    </div>

                    <notebook>
                        <page string="Personal Patients">
                            <field name="personal_patient_ids" readonly="1"/>
                            <tree create="0" delete="0"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id='hr_hospital_doctor_action_window' model='ir.actions.act_window'>
        <field name='name'>Doctors</field>
        <field name="res_model">hr_hospital.doctor</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>