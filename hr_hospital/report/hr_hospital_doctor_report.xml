<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_hospital_main_report" model="ir.actions.report">
        <field name="name">Doctor Appointment Report</field>
        <field name="model">hr_hospital.doctor</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">hr_hospital.hr_hospital_doctor_main_template</field>
        <field name="report_file">hr_hospital.hr_hospital_doctor_main_template</field>
        <field name="print_report_name">(object._get_report_base_filename())</field>
        <field name="attachment"/>
        <field name="binding_model_id" ref="model_hr_hospital_doctor"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

    <template id="hr_hospital_doctor_header_template">
        <div class="header"
             style="display:flex;
                    align-items:center;
                    padding-bottom:12px;
                    border-bottom:1px solid #dcdcdc;
                    margin-bottom:20px;">
            <t t-if="res_company.logo">
                <img t-att-src="'/web/image/res.company/%s/logo' % res_company.id"
                     style="max-height:60px; width:auto; margin-right:18px;"/>
            </t>
            <div style="font-size:12px; line-height:1.5; color:#444;">
                <div style="font-size:18px; font-weight:bold; color:#222; margin-bottom:4px;">
                    <t t-esc="res_company.name"/>
                </div>
                <div>
                    <t t-if="res_company.partner_id.zip">
                        <t t-esc="res_company.partner_id.zip"/>
                    </t>
                    <t t-if="res_company.partner_id.city">
                        <span>, </span>
                        <t t-esc="res_company.partner_id.city"/>
                    </t>
                </div>
                <t t-if="res_company.partner_id.street">
                    <div><t t-esc="res_company.partner_id.street"/></div>
                </t>
                <t t-if="res_company.partner_id.country_id">
                    <div><t t-esc="res_company.partner_id.country_id.name"/></div>
                </t>
                <t t-if="res_company.partner_id.phone">
                    <div>
                        <i class="fa fa-phone"/>
                        <t t-esc="res_company.partner_id.phone"/>
                    </div>
                </t>
                <t t-if="res_company.partner_id.email">
                    <div>
                        <i class="fa fa-envelope"/>
                        <t t-esc="res_company.partner_id.email"/>
                    </div>
                </t>
            </div>
        </div>
    </template>

    <template id="hr_hospital_doctor_footer_template">
        <div class="footer d-flex justify-content-between text-muted"
                 style="border-top: 1px solid #ddd; margin-top: 8px; margin-bottom: 8px;">
                 <table style="width: 100%;">
                    <tr>
                        <td style="text-align: left;">
                            <span class="fst-italic">
                                <t t-if="res_company.partner_id.city">
                                    <t t-esc="res_company.partner_id.city"/>
                                </t>
                            </span>
                        </td>
                        <td style="text-align: right;">
                            <span class="fst-italic">
                                Printed on:
                                <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%d.%m.%Y %H:%M')"/>
                            </span>
                        </td>
                    </tr>
                </table>
            </div>
    </template>

    <template id="hr_hospital_doctor_main_template">
        <t t-call="web.basic_layout">
            <t t-call="hr_hospital.hr_hospital_doctor_header_template"/>
            <main>
                <t t-foreach="docs" t-as="o">
                    <div class="page" style="page-break-after: always;">
                        <br/>
                        <h2><t t-out="o.name"/></h2>
                        <div class="text-muted">
                            <t t-out="o.category_id.name"/>
                            <span> • </span>
                            <t t-out="o.specialization"/>
                        </div>

                        <t t-if="not o.appointment_ids" class="mt-3">
                            <p>No appointments found.</p>
                        </t>

                        <t t-if="o.appointment_ids">
                            <div class="mt-3"><h5>History Visits</h5></div>
                            <table style="width: 100%;
                                          table-layout: fixed;
                                          border-collapse:collapse;
                                          border-bottom:1px solid #999;">
                                <thead style="border-top:1px solid #999;
                                              border-bottom:1px solid #999;
                                              text-align:left;">
                                    <tr style="background-color:#f2f2f2;">
                                        <th>Scheduled Date</th>
                                        <th>Actual Date</th>
                                        <th>Patient</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="appointments" t-value="o._get_appointments()"/>
                                    <t t-foreach="appointments" t-as="a">
                                        <tr>
                                            <td><t t-out="a.scheduled_datetime.strftime('%d.%m.%Y %H:%M')"/></td>
                                            <td>
                                                <t t-if="a.actual_datetime">
                                                    <t t-out="a.actual_datetime.strftime('%d.%m.%Y %H:%M')"/>
                                                </t>
                                            </td>
                                            <td><t t-out="a.patient_id.name"/></td>
                                            <td>
                                                <span t-att-style="'color: %s;' % a._get_state_color()">
                                                    <t t-out="a.state"/>
                                                </span>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                            <div class="mt-3"><h5>Patients</h5></div>
                            <table class="mb-3"
                                        style="width: 100%;
                                              table-layout: fixed;
                                              border-collapse:collapse;
                                              border-bottom:1px solid #999;">
                                <thead style="border-top:1px solid #999;
                                              border-bottom:1px solid #999;
                                              text-align:left;">
                                    <tr style="background-color:#f2f2f2;">
                                        <th>Name</th>
                                        <th>Gender</th>
                                        <th>Birth Date</th>
                                        <th>Phone</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="patients" t-value="o._get_patients()"/>
                                    <t t-foreach="patients" t-as="p">
                                        <tr>
                                            <td><t t-out="p.name"/></td>
                                            <td><t t-out="p.gender"/></td>
                                            <td><t t-out="p.birth_date"/></td>
                                            <td><t t-out="p.phone"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                    </div>
                </t>
            </main>
            <t t-call="hr_hospital.hr_hospital_doctor_footer_template"/>
        </t>
    </template>

</odoo>